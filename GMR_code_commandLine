#### main codes for GMR_database project 
#1.Metagenome assemmbly
#2.Species taxonomy 
#3.Species cluster
#4.Gene function annotation
#5.GUNC classification
#6.ARG identification
#7.Species abundance 

##############################################
########## 1. Metagenome Assemmbly ###########
##############################################

## We utilized a single sample metagenomic de novo assembly pipeline, code see https://github.com/MicrobiomeCardioMetaLab/CGMR.database_project

##############################################
########## 2. Species taxonomy ###############
##############################################

gtdbtk classify_wf --genome_dir ${inDir}  --extension fa --out_dir ${outDir} --cpus 16 --force --debug --skip_ani_screen

##############################################
########## 3. Species cluster ###############
##############################################

dRep dereplicate dRep  --genomeInfo dRep/data_tables/genomeInfo.csv --S_algorithm fastANI --multiround_primary_clustering  --greedy_secondary_clustering -comp 50 -con 5 -ms 10000 -pa 0.9 -sa 0.95 -nc 0.30 -cm larger -p 16

##############################################
######## 4. gene function annotation #########
##############################################

prokka ${input} --kingdom Bacteria --outdir ${outdir} --prefix ${prefix} --force --addgenes --cpus ${threads}
prokka ${input} --kingdom Archaea --outdir ${outdir} --prefix ${prefix} --force --addgenes --cpus ${threads}
mmseqs createdb GMR_478588_proteinnewID.faa GMRP_478588_DB
mmseqs cluster GMR_${BA_GENE}_rmdupDB GMR_${BA_GENE}_rmdupDB_clu tmp --cov-mode 0 -c 0.9 --min-seq-id 0.95  --threads ${threads}
mmseqs createtsv GMR_${BA_GENE}_rmdupDB GMR_${BA_GENE}_rmdupDB GMR_${BA_GENE}_rmdupDB_clu GMR_${BA_GENE}_rmdupDB_clu.tsv --threads ${threads}
less GMR_${BA_GENE}_rmdupDB_clu.tsv | cut -f 1 | sort | uniq -c | awk -F ' ' '{print $2}' | less > ${BA_GENE}_mmseq_cluID3.txt

##############################################
######### 5. GUNC classification #############
##############################################
gunc run \
 -r gunc_db_progenomes2.1.dmnd \
 -i ${sample}.fa.gz \
 -t 4 \
 -o sg_output/${sample} \
 --temp_dir sg_output/${sample} \
 --sensitive \
 --detailed_output

##############################################
########## 6. ARG identification #############
##############################################

abricate ${mag}.ffn --db resfinder > ${mag}.tsv


##############################################
########### 7. Species abundance #############
##############################################

metaphlan --bowtie2db DataBase/metaphlan4_GMR/  \
${fq_dir}/${sample}_paired_1.fastq.gz,${fq_dir}/${sample}_paired_2.fastq.gz \
--index mpa_v202403_GMR \ 
--input_type fastq --nproc ${threads} \
--output_file ${dir}/${sample}.profile \
-s ${dir}/${sample}.sam.bz2 \
--bowtie2out ${dir}/${sample}.bowtie2_out.bz2 \
--unclassified_estimation 
